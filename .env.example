# --- Copiar a .env (este archivo NO se sube a git) ---
# Usados por la CLI de Supabase y para el despliegue/local de Edge Functions.
# NUNCA deben llegar a la app del navegador (la app solo usa las variables VITE_ de app/.env).

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica
# La service role key SIENTE las políticas RLS. Solo para la máquina del admin.
SUPABASE_SERVICE_ROLE_KEY=service_role:tu-service-role-secret