# --- Copiar a app/.env (este archivo NO se sube a git) ---
# Proyecto de Supabase (URL del panel -> Project Settings -> API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave pública anon (pública por diseño; la seguridad vive en RLS, no en esta clave)
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica